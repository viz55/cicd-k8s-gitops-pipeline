pipeline {
    agent any

    tools {
        maven 'maven3'
    }
    environment {
    SCANNER_HOME = tool 'sonar-scanner'
    IMAGE_TAG = "v${BUILD_NUMBER}"
    PATH = "${WORKSPACE}/bin:${env.PATH}"
    }  
 
    stages {
        stage('Guard: Skip if this is our own automated commit') {
            steps {
                script {
                    // Single-repo pattern: this same pipeline will later
                    // commit an updated image tag back to THIS repo,
                    // which would normally re-trigger this exact
                    // pipeline via the webhook, forever. This stage
                    // checks the last commit message and aborts early
                    // if it matches the marker our own "Update Manifest"
                    // stage uses - the first of two independent
                    // safeguards (the second is the webhook path
                    // filter described in docs/IMPLEMENTATION-GUIDE.md).
                    def lastCommitMsg = sh(script: 'git log -1 --pretty=%B', returnStdout: true).trim()
                    if (lastCommitMsg.contains('[skip ci]')) {
                        currentBuild.result = 'NOT_BUILT'
                        error("Skipping build: last commit was an automated manifest update (${lastCommitMsg})")
                    }
                }
            }
        }

        stage('Git Checkout') {
            steps {
                git branch: 'main', credentialsId: 'git', url: 'https://github.com/viz55/cicd-k8s-gitops-pipeline.git'
            }
        }
	stage('Install Trivy') {
    	    steps {
                sh 'mkdir -p ${WORKSPACE}/bin && curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b ${WORKSPACE}/bin'
            } 
        }
        stage('Compile') {
            steps {
                sh "mvn compile"
            }
        }

        stage('Testing') {
            steps {
                sh "mvn test"
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh "trivy fs --exit-code 0 --severity HIGH,CRITICAL --format table -o fs-report.html ."
		archiveArtifacts artifacts: 'fs-report.html', allowEmptyArchive: true
            }
        }

        stage('Sonar Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh '''
    $SCANNER_HOME/bin/sonar-scanner \
    -Dsonar.projectKey=gcbank \
    -Dsonar.projectName=gcbank \
    -Dsonar.java.binaries=target \
    -Dsonar.sources=src \
    -Dsonar.exclusions=k8s/**,infra/**,docs/**,target/**,mvnw,mvnw.cmd \
    -Dsonar.javascript.exclusions=**/* \
    -Dsonar.typescript.exclusions=**/*
		'''
                }
            }
        }

        stage('Quality Gate Check') {
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token'
                }
            }
        }

        stage('Build') {
            steps {
                sh "mvn package"
            }
        }

        stage('Publish To Nexus') {
            steps {
                withMaven(globalMavenSettingsConfig: 'nexus-maven-settings', maven: 'maven3', traceability: true) {
                    sh "mvn deploy"
                }
            }
        }

        stage('Docker Image Build & Tag') {
    steps {
        container('dind') {
            withCredentials([usernamePassword(credentialsId: 'docker-cred', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                sh '''
                    echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                    docker build -t viz55/bankapp:$IMAGE_TAG .
                '''
            }
        }
    }
}

	stage('Scan Image') {
     steps {
        container('dind') {
            sh '''
                apk add --no-cache curl
                curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin
                trivy image --exit-code 0 --severity HIGH,CRITICAL --format table -o image-report.html viz55/bankapp:$IMAGE_TAG
            '''
            archiveArtifacts artifacts: 'image-report.html', allowEmptyArchive: true
        }
    }
}

	stage('Push Docker Image') {
    steps {
        container('dind') {
            withCredentials([usernamePassword(credentialsId: 'docker-cred', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                sh '''
                    echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                    docker push viz55/bankapp:$IMAGE_TAG
                '''
            }
        }
    }
}

        stage('Update Manifest In This Repo') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'git', usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_PASSWORD')]) {
                        sh '''
                            sed -i "s|viz55/bankapp:.*|viz55/bankapp:${IMAGE_TAG}|" k8s/manifest.yaml

                            echo "Updated manifest file contents:"
                            grep "image:" k8s/manifest.yaml

                            git config user.name "Jenkins"
                            git config user.email "jenkins@example.com"
                            git add k8s/manifest.yaml
                            # The [skip ci] marker is read by the Guard stage above -
                            # this exact commit, when the webhook fires again, will
                            # be recognized as our own automated change and aborted
                            # immediately instead of re-running the whole pipeline.
                            git commit -m "Update image tag to ${IMAGE_TAG} [skip ci]"
                            git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/viz55/cicd-k8s-gitops-pipeline.git HEAD:main
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def jobName = env.JOB_NAME
                def buildNumber = env.BUILD_NUMBER
                def pipelineStatus = currentBuild.result ?: 'UNKNOWN'
                def bannerColor = pipelineStatus.toUpperCase() == 'SUCCESS' ? 'green' : 'red'

                def body = """
                    <html>
                    <body>
                    <div style="border: 4px solid ${bannerColor}; padding: 10px;">
                    <h2>${jobName} - Build ${buildNumber}</h2>
                    <div style="background-color: ${bannerColor}; padding: 10px;">
                    <h3 style="color: white;">Pipeline Status: ${pipelineStatus.toUpperCase()}</h3>
                    </div>
                    <p>Check the <a href="${BUILD_URL}">console output</a>.</p>
                    </div>
                    </body>
                    </html>
                """

                emailext (
                    subject: "${jobName} - Build ${buildNumber} - ${pipelineStatus.toUpperCase()}",
                    body: body,
                    to: 'YOUR_REAL_EMAIL@example.com',
                    from: 'jenkins@example.com',
                    replyTo: 'jenkins@example.com',
                    mimeType: 'text/html',
                )
            }
        }
    }
}
