# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is (and must stay) in .gitignore.

tenancy_ocid        = "ocid1.tenancy.oc1..xxxxxxx"
user_ocid           = "ocid1.user.oc1..xxxxxxx"
fingerprint         = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path    = "~/.oci/oci_api_key.pem"
region              = "us-ashburn-1"
compartment_ocid    = "ocid1.compartment.oc1..xxxxxxx"
ssh_public_key_path = "~/.ssh/id_rsa.pub"

node_count = 1 # bump to 2 for a server+agent split, still free-tier eligible
environment = "dev"
